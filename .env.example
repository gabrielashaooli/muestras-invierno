# Llave de la API de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo de Claude a usar para analizar las fotos (opcional)
CLAUDE_MODEL=claude-sonnet-5

# Cadena de conexión de Neon Postgres (las tablas se crean solas)
DATABASE_URL=postgres://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Token de Vercel Blob para guardar las fotos
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Código compartido del equipo para entrar a la app
TEAM_CODE=invierno2026
